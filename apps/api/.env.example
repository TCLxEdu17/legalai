DATABASE_URL=postgresql://legalai:legalai_secret@localhost:5432/legal_ai
REDIS_URL=redis://localhost:6379

# JWT — Refresh tokens are UUIDs stored in DB, not JWTs.
JWT_SECRET=mude_este_secret_em_producao_use_64_chars_aleatorios
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── AI ─────────────────────────────────────────────────────────────────────────
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-6

# ── Uploads ────────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# Cloudflare R2 Storage (opcional — fallback para disco local se não configurado)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=legalai-uploads
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# ── Servidor ───────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
CORS_ORIGINS=http://localhost:3000
# Em produção: CORS_ORIGINS=https://legal.lasolutions.me
FRONTEND_URL=http://localhost:3000
# Em produção: FRONTEND_URL=https://legal.lasolutions.me
APP_URL=http://localhost:3000
# Em produção: APP_URL=https://legal.lasolutions.me

# ── RAG ────────────────────────────────────────────────────────────────────────
RAG_SIMILARITY_THRESHOLD=0.30
RAG_MAX_CHUNKS=5
RAG_TOP_K=3
CHUNK_SIZE=1500
CHUNK_OVERLAP=100

# ── Stripe (billing) ───────────────────────────────────────────────────────────
# Obrigatório para pagamentos. Obtenha em https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Obrigatório para validar webhooks. Obtenha em Stripe → Webhooks → seu endpoint
STRIPE_WEBHOOK_SECRET=whsec_...
# IDs dos preços criados no Stripe Dashboard (Products → Pricing)
STRIPE_BASIC_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_UNLIMITED_PRICE_ID=price_...

# ── Email (Resend) ─────────────────────────────────────────────────────────────
# Obrigatório para notificações de trial e reset de senha. https://resend.com
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=LegalAI <noreply@lasolutions.me>
# Email do dono para receber notificações de novos trials
OWNER_EMAIL=seu@email.com.br

# ── Email (SMTP) — usado para notificações de radar ───────────────────────────
# Pode usar Resend SMTP: host=smtp.resend.com, user=resend, pass=RESEND_API_KEY, port=587
SMTP_HOST=smtp.resend.com
SMTP_USER=resend
SMTP_PASS=re_...
SMTP_PORT=587
SMTP_FROM=LegalAI <noreply@lasolutions.me>

# ── Admin seed ────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@legalai.com.br
ADMIN_PASSWORD=troque-em-producao-minimo-16-chars

# ── Monitoramento ─────────────────────────────────────────────────────────────
# Obtenha em https://sentry.io
SENTRY_DSN=
