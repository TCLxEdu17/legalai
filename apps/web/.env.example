# Em desenvolvimento: http://localhost:3001
# Em produção: https://api.seudominio.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# Meta Pixel — obter em business.facebook.com/events-manager
# Deixar vazio para desativar o rastreamento (ex: ambiente de dev/staging)
NEXT_PUBLIC_FB_PIXEL_ID=SEU_PIXEL_ID_AQUI

# PostHog — analytics e session recording (posthog.com, plano free = 1M eventos/mês)
NEXT_PUBLIC_POSTHOG_KEY=phc_SEU_PROJECT_API_KEY
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
